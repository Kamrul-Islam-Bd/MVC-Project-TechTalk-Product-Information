@model IEnumerable<TechTalk.Models.CartItem>

<h2>Your Shopping Cart</h2>

<table class="table">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CartItems)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Product.Price.ToString("c")</td>
                <td>@item.Quantity</td>
                <td>@(item.Product.Price * item.Quantity).ToString("c")</td>
                <td>
                    @Html.ActionLink("Remove", "RemoveFromCart", new { productId = item.Product.ProductId })
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3">Total</td>
            <td>@Model..Sum(item => item.Product.Price * item.Quantity).ToString("c")</td>
            <td>
                @Html.ActionLink("Empty Cart", "EmptyCart", "Cart")
            </td>
        </tr>
    </tfoot>
</table>
