@model IEnumerable<TechTalk.ViewModels.Program>

@{
    ViewBag.Title = "Index";
}

<div class="container">
    <h2 class="my-4">Programs</h2>

    <p>
        <a href="@Url.Action("Create", "Programs")" class="btn btn-primary">Create New Program</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Program Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ProgramName)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("Edit", new { id = item.ProgramId })" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="fa fa-pencil"></i> Edit
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.ProgramId })" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fa fa-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div>
        <a href="@Url.Action("Create", "Products")" class="btn btn-secondary">Back to Product Creation</a>
    </div>
</div>
